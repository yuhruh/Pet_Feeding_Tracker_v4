<% content_for :title, t('trackers.index.title', petname: @pet.petname.capitalize) + " (Shared)" %>

<div class="container mx-auto py-8">
  <div class="flex flex-col justify-center items-center mb-6">
    <h1 class="font-bold text-center text-2xl md:text-4xl"><%= t('trackers.index.title', petname: @pet.petname.capitalize) %></h1>
    <p class="underline decoration-double underline-offset-4 text-gray-500 italic mt-2"><%= t('shared_trackers.read_only_view') %></p>
  </div>
  
  <%# Chart Section %>
  <div class="flex flex-col mb-8 justify-center items-center mx-auto w-full lg:w-11/12">
    <div class="flex justify-end items-end pr-8 pt-4 mb-4 w-full" data-controller="range-form">
      <div class="relative">
        <div class="inline-flex w-full justify-center px-3 py-2 inset-ring-1 inset-ring-gray-300 cursor-pointer">
          <%= form_with url: shared_pet_trackers_path(share_token: @pet.share_token), method: :get, class: "flex items-center" do |form| %>
            <span class="mr-2"><%= t('trackers.index.chart_range') %></span>
            <%= form.select :range, options_for_select([[t('trackers.index.all_time'), "all"], [t('trackers.index.last_7_days'), "7"], 
            [t('trackers.index.last_30_days'), "30"], [t('trackers.index.last_120_days'), "120"], [t('trackers.index.last_180_days'), "180"], [t('trackers.index.year_to_date'), "YTD"], [t('trackers.index.custom'), "custom"]], params[:range] || "all"), {}, 
            { data: { action: "change->range-form#toggleForm" }, class: "p-1 rounded-md shadow-lg font-semibold border-2 border-blue-300 text-gray-700 bg-sky-200 
            hover:bg-gray-200 hover:border-gray-400 hover:text-sky-700" } %>
          <% end %>
        </div>
        <div data-range-form-target="form" class="absolute hidden w-max top-full mt-2 py-2 z-30">
          <%= form_with url: shared_pet_trackers_path(share_token: @pet.share_token), method: :get, class: "flex items-center ml-4" do |form| %>
            <div class= "inline-flex w-full justify-center bg-white px-3 py-2 text-grayishBlue rounded-md shadow-lg tracking-wide inset-ring-1 inset-ring-gray-300 dark:bg-darkBlue cursor-pointer">
              <%= form.hidden_field :range, value: "custom" %>
                <div class="flex flex-col items-center gap-4">
                  <div class="flex items-center">
                    <span class="mr-2"><%= t('trackers.index.start_date') %></span>
                    <%= form.date_field :start_date, value: params[:start_date], class: "p-1 rounded-md shadow-lg font-semibold border-2 border-blue-300 text-gray-700 bg-sky-200", min: @min_date, max: @max_date %>
                  </div>
                  <div class="flex items-center">
                    <span class="mr-2"><%= t('trackers.index.end_date') %></span>
                    <%= form.date_field :end_date, value: params[:end_date], class: "p-1 rounded-md shadow-lg font-semibold border-2 border-blue-300 text-gray-700 bg-sky-200", min: @min_date, max: @max_date %>
                  </div>
                  <div class="flex items-center">
                    <%= form.submit t('trackers.index.apply_custom_range'), class: "p-2 ml-4 rounded-md shadow-lg font-semibold border-2 border-blue-300 text-gray-700 bg-sky-200 hover:bg-gray-200 hover:border-gray-400 hover:text-sky-700" %>
                  </div>
                </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%= render "shared/tracker_chart" %>
  </div>

  <%# Data Table %>
  <div class="overflow-x-auto shadow-lg rounded-xl max-h-[80vh] w-full">
    <table class="table-auto w-full dark:bg-slate-100">
      <thead>
        <tr class="bg-gray-100 dark:bg-black">
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.number') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.date') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.time') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.hungry') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.come_back_to_eat') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.food_type') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.brand') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.description') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.amount') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.left_amount') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.total_ate_amount') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.result') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.weight') %></th>
          <th class="sticky top-0 z-20 bg-gray-100 dark:bg-black border-b-4 border-gray-200 dark:border-gray-800 capitalize text-sm text-center p-2 dark:text-white"><%= t('trackers.tracker.note') %></th>
        </tr>
      </thead>
      <tbody>
        <% @trackers.each_with_index do |record, idx| %>
          <% next_record = @trackers[idx + 1] %>
          <% date_changed = (next_record && next_record.date != record.date) %>
          <tr class="border-b <%= tracker_row_class(record) %> <%= 'border-b-2 border-gray-400' if date_changed %>">
            <td class="capitalize text-sm text-center p-2 font-semibold"><%= idx + 1 %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.date.strftime("%Y-%m-%d") %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.feed_time&.strftime("%H:%M") %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.hungry.present? ? t("trackers.hungry_options.#{record.hungry}") : "" %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.come_back_to_eat %></td>
            <td class="capitalize text-sm text-center p-2"><%= t("trackers.food_types.#{record.food_type.downcase}") %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.brand %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.description %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.amount %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.left_amount %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.total_ate_amount %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.result %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.weight %></td>
            <td class="capitalize text-sm text-center p-2"><%= record.note %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex justify-center mt-8 italic text-gray-500">
    <%= will_paginate @trackers %>
  </div>
</div>
