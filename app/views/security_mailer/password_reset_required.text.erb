<% SecurityMailer::LOCALES.each_with_index do |locale, index| -%>
<% I18n.with_locale(locale) do -%>
<%= "----------------------------------------\n\n" if index.positive? -%>
<%= t("security_mailer.password_reset_required.greeting", username: @user.username) %>

<%= t("security_mailer.password_reset_required.what_happened") %>

<%= t("security_mailer.password_reset_required.what_we_did") %>

<%= t("security_mailer.password_reset_required.what_to_do_text") %>
<%= new_password_url(locale: locale) %>

<%= t("security_mailer.password_reset_required.other_sites") %>

<%= t("security_mailer.password_reset_required.apology") %>

<% end -%>
<% end -%>
