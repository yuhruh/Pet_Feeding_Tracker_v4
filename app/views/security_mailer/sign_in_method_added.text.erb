<% SecurityMailer::LOCALES.each_with_index do |locale, index| -%>
<% I18n.with_locale(locale) do -%>
<%= "----------------------------------------\n\n" if index.positive? -%>
<%= t("security_mailer.sign_in_method_added.greeting", username: @user.username) %>

<%= t("security_mailer.sign_in_method_added.what_happened", provider: @provider) %>

<%= t("security_mailer.sign_in_method_added.if_not_you_text") %>
<%= users_url(locale: locale, anchor: "sign-in-methods") %>

<% end -%>
<% end -%>
