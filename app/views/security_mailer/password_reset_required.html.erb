<% SecurityMailer::LOCALES.each_with_index do |locale, index| %>
  <% I18n.with_locale(locale) do %>
    <%= tag.hr if index.positive? %>
    <div lang="<%= locale %>">
      <p><%= t("security_mailer.password_reset_required.greeting", username: @user.username) %></p>
      <p><%= t("security_mailer.password_reset_required.what_happened") %></p>
      <p><%= t("security_mailer.password_reset_required.what_we_did") %></p>
      <p><%= t("security_mailer.password_reset_required.what_to_do_html", forgot_password_link: link_to(t("security_mailer.password_reset_required.forgot_password_link"), new_password_url(locale: locale))) %></p>
      <p><%= t("security_mailer.password_reset_required.other_sites") %></p>
      <p><%= t("security_mailer.password_reset_required.apology") %></p>
    </div>
  <% end %>
<% end %>
