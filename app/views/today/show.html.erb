<% content_for :title, t(".title") %>
<%# A tap returns to this page; morphing keeps the scroll position. %>
<% content_for :head, turbo_refreshes_with(method: :morph, scroll: :preserve) %>

<div class="container mx-auto w-full px-2 md:w-2/3 mb-8 space-y-6">
  <h1 class="text-center font-bold text-3xl md:text-4xl"><%= t(".title") %></h1>

  <% Current.user.incoming_ownership_transfers.pending.includes(:from_user, household: :owner).each do |transfer| %>
    <div class="p-3 rounded-lg border-2 border-amber-200 bg-amber-50 text-center dark:text-gray-800">
      <%= t(".transfer_offer", owner: transfer.from_user.username.capitalize, household: household_name(transfer.household)) %>
      <%= link_to t(".review_offer"), ownership_transfer_offer_path(transfer), class: "ml-2 font-semibold text-amber-800 underline" %>
    </div>
  <% end %>

  <% if @days.empty? %>
    <div class="text-center space-y-3">
      <p class="text-gray-600 dark:text-gray-300"><%= t(".nothing_yet") %></p>
      <%= link_to t(".add_a_cat"), new_pet_path, class: "inline-block rounded-md px-3.5 py-2 text-orange-600 bg-orange-200 font-medium hover:bg-white" %>
    </div>
  <% end %>

  <% @days.each do |day| %>
    <% household = day.household %>
    <% role = @roles[household.id] %>
    <% can_record = HouseholdPolicy.new(Current.user, household).can?(:record_care) %>
    <section id="<%= dom_id(household) %>" class="border-2 border-slate-200 rounded-xl shadow-lg p-4">
      <%# Live updates: everyone's changes in this household refresh the page in place. %>
      <%= turbo_stream_from household %>
      <h2 class="font-semibold text-xl mb-3">
        <%= role ? household_name(household) : t(".my_cats") %>
        <% if role %>
          <span class="ml-2 rounded-full px-2 py-0.5 text-xs bg-sky-100 text-sky-700 align-middle"><%= t(".you_are_a.#{role}") %></span>
        <% end %>
      </h2>
      <% if can_record %>
        <%# Each owner or caregiver's own reminders for this household (checkpoint H). %>
        <% reminders_on = household.reminders_on_for?(Current.user) %>
        <div id="<%= dom_id(household, :reminders) %>" class="-mt-2 mb-3 flex flex-wrap items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
          <span><%= t(reminders_on ? ".reminders.on" : ".reminders.off", channel: t(".reminders.channels.#{@reminder_channel}")) %></span>
          <%= button_to t(reminders_on ? ".reminders.turn_off" : ".reminders.turn_on"), household_reminders_path(household), method: :patch,
                params: { enabled: !reminders_on }, class: "text-sky-700 underline cursor-pointer" %>
          <% if reminders_on && hotwire_native_app? %>
            <%# In the Android app, reminders on: ask for the notification permission (once) and register this phone. %>
            <span data-controller="push" data-push-url-value="<%= device_token_path %>" data-push-ask-value="true" hidden></span>
          <% end %>
        </div>
      <% end %>

      <% if @repeat && @repeat["event"]&.household_id == household.id %>
        <%= render "care_events/repeat_prompt", repeat: @repeat %>
      <% end %>
      <% if @saved_event&.household_id == household.id %>
        <%= render "care_events/notice", event: @saved_event %>
      <% end %>

      <% if day.pets.empty? && day.spots.empty? %>
        <p class="text-gray-600 dark:text-gray-300"><%= t(".no_cats") %></p>
      <% else %>
        <%= render "care_events/status", day: day, can_record: can_record %>
        <p class="mt-2 flex flex-wrap gap-4 text-sm">
          <% day.pets.each do |pet| %>
            <%= link_to t(role == "viewer" ? ".pet_charts" : ".pet_trackers", pet: pet_display_name(pet)), pet_trackers_path(pet), class: "text-sky-700 underline" %>
          <% end %>
        </p>
        <%= render "care_events/timeline", day: day, reader: Current.user %>
      <% end %>
    </section>
  <% end %>
</div>
