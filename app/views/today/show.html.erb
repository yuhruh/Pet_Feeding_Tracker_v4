<% content_for :title, t(".title") %>

<div class="container mx-auto w-full px-2 md:w-2/3 mb-8 space-y-6">
  <h1 class="text-center font-bold text-3xl md:text-4xl"><%= t(".title") %></h1>

  <% Current.user.incoming_ownership_transfers.pending.includes(:from_user, household: :owner).each do |transfer| %>
    <div class="p-3 rounded-lg border-2 border-amber-200 bg-amber-50 text-center dark:text-gray-800">
      <%= t(".transfer_offer", owner: transfer.from_user.username.capitalize, household: household_name(transfer.household)) %>
      <%= link_to t(".review_offer"), ownership_transfer_offer_path(transfer), class: "ml-2 font-semibold text-amber-800 underline" %>
    </div>
  <% end %>

  <% if @households.empty? %>
    <div class="text-center space-y-3">
      <p class="text-gray-600 dark:text-gray-300"><%= t(".nothing_yet") %></p>
      <%= link_to t(".add_a_cat"), new_pet_path, class: "inline-block rounded-md px-3.5 py-2 text-orange-600 bg-orange-200 font-medium hover:bg-white" %>
    </div>
  <% end %>

  <% @households.each do |household| %>
    <% role = @roles[household.id] %>
    <section id="<%= dom_id(household) %>" class="border-2 border-slate-200 rounded-xl shadow-lg p-4">
      <h2 class="font-semibold text-xl mb-3">
        <%= role ? household_name(household) : t(".my_cats") %>
        <% if role %>
          <span class="ml-2 rounded-full px-2 py-0.5 text-xs bg-sky-100 text-sky-700 align-middle"><%= t(".you_are_a.#{role}") %></span>
        <% end %>
      </h2>
      <% pets = @pets[household.id] || [] %>
      <% if pets.empty? %>
        <p class="text-gray-600 dark:text-gray-300"><%= t(".no_cats") %></p>
      <% else %>
        <ul class="divide-y divide-slate-200">
          <% pets.each do |pet| %>
            <li class="flex flex-wrap justify-between items-center gap-2 py-2">
              <span class="font-medium"><%= pet.petname.split(" ").map(&:capitalize).join(" ") %></span>
              <span class="flex gap-4 text-sm">
                <% if role == "viewer" %>
                  <%= link_to t(".charts"), pet_trackers_path(pet), class: "text-sky-700 underline" %>
                <% else %>
                  <%= link_to t(".trackers_and_charts"), pet_trackers_path(pet), class: "text-sky-700 underline" %>
                  <%= link_to t(".favorites"), favorite_food_pet_trackers_path(pet), class: "text-rose-700 underline" %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</div>
