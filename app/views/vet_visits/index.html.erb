<% content_for :title, t('.title', petname: @pet.petname.capitalize) %>

<%= form_with url: batch_update_pet_vet_visits_path(@pet), method: :patch, local: true, data: { controller: "bulk-edit" } do |form| %>

  <div class="container mx-auto border-4 border-amber-600 rounded-lg shadow-2xl mb-6 p-6 w-full md:w-4/5 bg-white dark:bg-gray-900">
    <div class="flex flex-col justify-center items-center mb-6">
      <h1 class="text-center font-bold text-3xl text-amber-700 dark:text-amber-500 underline underline-offset-8 decoration-amber-700 decoration-2 capitalize md:text-4xl">
        <%= t('.header', petname: @pet.petname.capitalize) %>
      </h1>

      <% # Show Vet Name & Consultation Time at the very top of the entire questions list %>
      <% latest_visit = @vet_visits.detect { |v| v.vet_name.present? || v.consultation_time.present? } || @vet_visits.first %>
      <% if latest_visit && (latest_visit.vet_name.present? || latest_visit.consultation_time.present?) %>
        <div class="mt-4 p-4 bg-amber-50/55 dark:bg-gray-800/50 border-2 border-amber-200 dark:border-gray-700 rounded-xl text-center max-w-md w-full shadow-sm">
          <h2 class="font-bold text-xs text-amber-800 dark:text-amber-400 mb-1 tracking-wider uppercase">
            <%= t('.latest_visit_info', default: "Vet Visit Info") %> (<%= latest_visit.visit_date %>)
          </h2>
          <div class="flex justify-center items-center gap-6 text-sm text-gray-700 dark:text-gray-300 font-medium">
            <% if latest_visit.vet_name.present? %>
              <div>👨‍⚕️ <%= t('.vet_name_label') %>: <span class="text-gray-900 dark:text-white font-bold"><%= latest_visit.vet_name %></span></div>
            <% end %>
            <% if latest_visit.consultation_time.present? %>
              <div>⏱️ <%= t('.duration_label') %>: <span class="text-gray-900 dark:text-white font-bold"><%= latest_visit.consultation_time %> <%= t('.minutes', default: 'mins') %></span></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex flex-col md:flex-row justify-center items-center gap-4 mb-6">
      <% if @pet.user == Current.user %>
        <%= link_to t('.add_new_visit'), new_pet_vet_visit_path(@pet), class: "text-center rounded-md px-5 py-2.5 text-white bg-amber-600 hover:bg-white hover:text-amber-600 border-2 border-amber-600 font-semibold cursor-pointer transition duration-300 w-full md:w-auto" %>
      <% end %>

      <% if @vet_visits.any? %>
        <button type="button"
                data-bulk-edit-target="editButton"
                data-action="click->bulk-edit#toggleEdit"
                class="text-center rounded-md px-5 py-2.5 text-white bg-green-600 hover:bg-white hover:text-green-600 border-2 border-green-600 font-semibold cursor-pointer transition duration-300 w-full md:w-auto">
          <%= t('.edit_all_visits', default: "Edit All") %>
        </button>

        <%= form.submit t('.save_all_changes', default: "Save Changes"),
                        data: { bulk_edit_target: "saveButton" },
                        class: "hidden text-center rounded-md px-5 py-2.5 text-white bg-green-600 hover:bg-white hover:text-green-600 border-2 border-green-600 font-semibold cursor-pointer transition duration-300 w-full md:w-auto" %>

        <button type="button"
                data-bulk-edit-target="cancelButton"
                data-action="click->bulk-edit#toggleEdit"
                class="hidden text-center rounded-md px-5 py-2.5 text-white bg-gray-500 hover:bg-white hover:text-gray-500 border-2 border-gray-500 font-semibold cursor-pointer transition duration-300 w-full md:w-auto">
          <%= t('.cancel', default: "Cancel") %>
        </button>
      <% end %>
    </div>

    <div id="vet_visits" class="space-y-6">
      <% if @vet_visits.any? %>
        <% @vet_visits.group_by(&:visit_date).each do |visit_date, visits| %>
          <% first_visit = visits.first %>
          <div class="border-2 border-amber-200 rounded-xl p-6 shadow-md bg-amber-50/30 dark:bg-gray-800/50 space-y-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-amber-200 pb-3 gap-2">
              <div>
                <span class="text-sm font-semibold text-amber-800 dark:text-amber-400 uppercase tracking-wider"><%= t('.visit_date') %>:</span>
                
                <span data-bulk-edit-target="viewState" class="ml-1 text-lg font-bold text-gray-800 dark:text-white">
                  <%= visit_date %>
                </span>

                <div data-bulk-edit-target="editState" class="hidden ml-1 inline-block">
                  <% if @pet.user == Current.user %>
                    <%= form.date_field "vet_visits[#{first_visit.id}][visit_date]", value: visit_date, class: "rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1 bg-white dark:bg-gray-800 text-gray-800 dark:text-white font-medium focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
                  <% else %>
                    <span class="text-lg font-bold text-gray-800 dark:text-white"><%= visit_date %></span>
                  <% end %>
                </div>
              </div>
              <div class="text-sm text-gray-500 space-y-1 md:text-right">
                <div><%= t('.created_date') %>: <%= first_visit.created_at.to_date %></div>
              </div>
            </div>

            <div class="space-y-4 pt-2">
              <% visits.each do |visit| %>
                <div class="border border-amber-100 dark:border-gray-700 p-4 rounded-lg bg-white/50 dark:bg-gray-900/50 space-y-3">
                  <div>
                    <h4 class="font-bold text-sm text-amber-900 dark:text-amber-400"><%= t('.question_label') %>:</h4>
                    
                    <p data-bulk-edit-target="viewState" class="text-gray-700 dark:text-gray-200 italic">
                      <%= visit.question %>
                    </p>

                    <div data-bulk-edit-target="editState" class="hidden">
                      <% if @pet.user == Current.user %>
                        <%= form.text_area "vet_visits[#{visit.id}][question]", value: visit.question, rows: 2, class: "w-full rounded-md border border-gray-300 dark:border-gray-700 p-2 text-sm bg-white dark:bg-gray-800 text-gray-800 dark:text-white font-medium focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
                      <% else %>
                        <p class="text-gray-500 dark:text-gray-400 italic text-sm bg-gray-100 dark:bg-gray-800/80 p-2 rounded">
                          <%= visit.question %>
                        </p>
                      <% end %>
                    </div>
                  </div>

                  <div>
                    <h4 class="font-bold text-sm text-amber-900 dark:text-amber-400"><%= t('.answer_label') %>:</h4>
                    
                    <% if visit.answer.present? %>
                      <p data-bulk-edit-target="viewState" class="text-gray-700 dark:text-gray-200">
                        <%= visit.answer %>
                      </p>
                    <% else %>
                      <p data-bulk-edit-target="viewState" class="text-gray-400 italic">
                        <%= t('.no_answer_yet') %>
                      </p>
                    <% end %>

                    <div data-bulk-edit-target="editState" class="hidden">
                      <%= form.text_area "vet_visits[#{visit.id}][answer]", value: visit.answer, rows: 2, class: "w-full rounded-md border border-gray-300 dark:border-gray-700 p-2 text-sm bg-white dark:bg-gray-800 text-gray-800 dark:text-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500" %>
                    </div>
                  </div>

                  <% if @pet.user == Current.user && visit.members.any? %>
                    <div class="pt-2">
                      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t('.shared_members') %>:</span>
                      <div class="flex flex-wrap gap-2 mt-1">
                        <% visit.members.each do |member| %>
                          <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-medium">
                            <%= member.username %> (<%= member.email_address %>)
                          </span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <div data-bulk-edit-target="viewState" class="flex flex-wrap items-center gap-3 pt-2 border-t border-amber-50 dark:border-gray-800">
                    <%= link_to t('.edit'), edit_pet_vet_visit_path(@pet, visit), class: "text-center rounded-md px-4 py-2 text-green-600 bg-green-100 hover:bg-green-200 font-bold text-sm transition duration-300" %>
                    <% if @pet.user == Current.user %>
                      <%= link_to t('.delete'), pet_vet_visit_path(@pet, visit), data: { turbo_method: :delete, turbo_confirm: t('.confirm_delete') }, class: "text-red-600 hover:text-red-700 font-bold text-xs" %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-4">
          <p class="text-gray-500 text-lg mb-4"><%= t('.no_visits', petname: @pet.petname.capitalize) %></p>
        </div>
      <% end %>
    </div>

    <div class="flex justify-center mt-6">
      <%= link_to t('.back_to_pet', petname: @pet.petname.capitalize), pet_path(@pet), class: "text-center rounded-md px-5 py-2.5 text-white bg-gray-500 hover:bg-white hover:text-gray-500 border-2 border-gray-500 inline-block font-semibold cursor-pointer transition duration-300" %>
    </div>
  </div>

<% end %>
