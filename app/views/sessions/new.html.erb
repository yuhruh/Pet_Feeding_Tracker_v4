<div class="mx-auto md:w-1/2">
  <div class="mx-auto mb-6">
    <h1 class="text-center font-semibold text-xl md:text-2xl lg:text-4xl"><%= t(".title") %></h1>
  </div>

  <%# After a failed sign-in both fields are marked together: marking only one would reveal whether the email has an account. %>
  <% field_border = @sign_in_failed ? "border-red-500" : "border-gray-400" %>
  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="flex flex-col justify-center items-center space-x-3 mb-4 md:flex-row">
      <label for="email_address" class="text-base font-medium mx-4 text-gray-700 required dark:text-gray-100"><%= t(".email") %></label>
      <div class="flex flex-col w-1/2" data-controller="email-suggestion" data-email-suggestion-template-value="<%= t(".email_suggestion") %>">
        <%= form.email_field :email_address, required: true, autofocus: !@sign_in_failed, autocomplete: "username", placeholder: t(".email_placeholder"), value: params[:email_address],
              aria: { invalid: @sign_in_failed || nil, describedby: "email_suggestion" },
              data: { email_suggestion_target: "input", action: "blur->email-suggestion#check input->email-suggestion#clear" },
              class: "shadow-md rounded-md border #{field_border} focus:outline-softBlue px-3 py-2 w-full dark:text-black" %>
        <button type="button" id="email_suggestion" hidden data-email-suggestion-target="suggestion" data-action="email-suggestion#apply" class="mt-1 text-sm text-left text-softBlue underline dark:text-sky-300"></button>
      </div>
    </div>

    <div class="flex flex-col justify-center items-center space-x-3 mb-4 md:flex-row">
      <label for="password" class="text-base font-medium text-gray-700 required dark:text-gray-100"><%= t(".password") %></label>
      <div class="flex flex-col w-1/2" data-controller="password-field"
           data-password-field-show-label-value="<%= t(".show_password") %>"
           data-password-field-hide-label-value="<%= t(".hide_password") %>">
        <div class="flex items-center gap-2">
          <%= form.password_field :password, required: true, autofocus: @sign_in_failed, autocomplete: "current-password", placeholder: t(".password_placeholder"), maxlength: 72,
                aria: { invalid: @sign_in_failed || nil, describedby: "caps_lock_warning" },
                data: { password_field_target: "input", action: "keydown->password-field#checkCapsLock keyup->password-field#checkCapsLock blur->password-field#hideCapsLock" },
                class: "shadow-md rounded-md border #{field_border} focus:outline-blue-400 px-3 py-2 w-full dark:text-black" %>
          <button type="button" aria-controls="password" aria-pressed="false" data-password-field-target="toggle" data-action="password-field#toggle" class="text-sm text-softBlue underline whitespace-nowrap dark:text-sky-300"><%= t(".show_password") %></button>
        </div>
        <p id="caps_lock_warning" hidden data-password-field-target="capsWarning" class="mt-1 text-sm text-amber-700 dark:text-amber-400">⇪ <%= t(".caps_lock_on") %></p>
      </div>
    </div>

    <div class="flex flex-col justify-center items-center space-x-4 md:flex-row">
      <div class="mb-4">
        <%= form.submit t(".submit_button"), class: "text-center rounded-md px-3.5 py-2.5 text-white bg-softBlue hover:bg-white hover:text-softBlue hover:border-2 hover:border-softBlue inline-block font-medium cursor-pointer" %>
      </div>

      <div class="text-base items-center text-gray-500 md:mt-0">
        <%= link_to t(".forgot_password_link"), new_password_path, class: "text-gray-700 underline hover:no-underline dark:text-gray-100" %>
      </div>
    </div>
  <% end %>

  <div class="relative flex py-5 items-center">
    <div class="flex-grow border-t border-gray-400"></div>
    <span class="flex-shrink text-sm mx-4 text-gray-400 md:text-base"><%= t(".or_sign_in_with") %></span>
    <div class="flex-grow border-t border-gray-400"></div>
  </div>

  <div class="mt-3 flex flex-col justify-center items-center gap-6">
    <div class="flex gap-8">
      <%= form_with url: "/auth/google_oauth2", method: :post, data: { controller: "time-zone", action: "submit->time-zone#setAuthUrl" } do |form| %>
        <button type="submit" class="btn flex items-center justify-center py-2 rounded-md text-sm cursor-pointer">
          <%= image_tag "icons8-google-40.png", style: "width: 20px; height: 20px;" %>
          <span class="ml-2 text-softBlue font-semibold underline decoration-2 decoration-softBlue"><%= t(".google_button") %></span>
        </button>
      <% end %>

      <%= form_with url: "/auth/line", method: :post, data: { controller: "time-zone", action: "submit->time-zone#setAuthUrl" } do |form| %>
        <button type="submit" class="btn flex items-center justify-center py-2 rounded-md text-sm cursor-pointer">
          <%= image_tag "icons8-line-48.png", style: "width: 25px; height: 25px;" %>
          <span class="ml-2 text-softBlue font-semibold underline decoration-2 decoration-softBlue"><%= t(".line_button") %></span>
        </button>
      <% end %>

      <%= form_with url: "/auth/github", method: :post, data: { controller: "time-zone", action: "submit->time-zone#setAuthUrl" } do |form| %>
        <button type="submit" class="btn flex items-center justify-center py-2 rounded-md text-sm cursor-pointer">
          <%= svg "github" %>
          <span class="ml-2 text-softBlue font-semibold underline decoration-2 decoration-softBlue"><%= t(".github_button") %></span>
        </button>
      <% end %>
    </div>
    <div class="mb-3 flex justify-center items-center gap-4">
      <span id="HelpBlock" class="text-center text-gray-500 dark:text-gray-100"><%= t(".help_text_html", google_icon: image_tag("icons8-google-40.png", style: "width: 20px; height: 20px;", class: "inline-block align-middle"), chrome_icon: svg("chrome"), edge_icon: content_tag(:span, svg("edge"), class: "w-6 h-6 inline-block align-middle"), firefox_icon: content_tag(:span, svg("firefox"), class: "w-6 h-6 inline-block align-middle")) %></span>
    </div>
  </div>
</div>
