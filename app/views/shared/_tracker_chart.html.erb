<%# The amount and weight chart; uses @data, @min_weight, @max_weight, @dry_properties and @wet_properties. %>
<div class="w-full px-4 py-6 md:px-12 mx-auto">
  <h3 class="text-center capitalize font-bold text-lg text-gray-700 dark:text-gray-200 mb-2"><%= t('trackers.index.chart_title') %></h3>
  <% if @dry_properties.present? || @wet_properties.present? %>
    <div class="w-full border border-gray-100 rounded-lg shadow-sm bg-white dark:bg-slate-800 dark:border-slate-700 p-2">
      <%# Opens on the last 30 days; the slider underneath moves through the rest. %>
      <div id="pet-chart" style="height: 400px;" data-controller="echart" data-action="turbo:before-morph-element->echart#keep"
           data-echart-options-value="<%= amount_chart_options(@data, min_weight: @min_weight, max_weight: @max_weight).to_json %>"
           data-echart-visible-days-value="30" data-echart-day-width-value="15"></div>
    </div>
  <% else %>
    <div class="text-center p-8 my-4 bg-gray-100 rounded-lg shadow-lg">
      <p class="font-semibold text-gray-700"><%= t('trackers.index.no_data_for_chart') %></p>
    </div>
  <% end %>
</div>
