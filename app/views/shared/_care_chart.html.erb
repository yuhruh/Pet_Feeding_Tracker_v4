<%# "Care by day" under the amount chart: the household's litter and water jobs and the cat's tapped feedings, doses and litter observations (CareChart). %>
<% if care&.any? %>
  <section id="care_chart" class="w-full px-8 md:px-12 mx-auto mb-6">
    <h3 class="text-center font-bold text-lg text-gray-700 dark:text-gray-200 mb-1"><%= t("care_chart.title") %></h3>
    <p class="text-center text-xs text-gray-500 dark:text-gray-300 mb-2"><%= t("care_chart.explanation") %></p>
    <div class="w-full border border-gray-100 rounded-lg shadow-sm bg-white dark:bg-slate-800 dark:border-slate-700 p-2">
      <div id="care-chart" style="height: 300px;" data-controller="echart" data-action="turbo:before-morph-element->echart#keep"
           data-echart-options-value="<%= care_chart_options(care).to_json %>" data-echart-day-width-value="40"></div>
    </div>
  </section>
<% end %>
