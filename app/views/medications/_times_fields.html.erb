<%# Up to four times of day; none means "as needed". %>
<div class="flex flex-wrap items-center gap-2">
  <% Medication::MAX_TIMES.times do |index| %>
    <%= time_field_tag "medication[times][]", medication.times[index], id: "#{prefix}_time_#{index}", "aria-label": t("medications.index.time_n", n: index + 1),
          class: "rounded-md border px-2 py-1 dark:text-black" %>
  <% end %>
</div>
<p class="text-xs text-gray-500"><%= t("medications.index.times_hint") %></p>
