<% petname = @pet.petname.split(" ").map(&:capitalize).join(" ") %>
<% content_for :title, t(".title", petname: petname) %>

<div class="container mx-auto w-full px-2 md:w-2/3 mb-8">
  <div class="flex flex-col items-center text-center mb-4">
    <h1 class="font-bold text-3xl md:text-4xl mb-2"><%= t(".title", petname: petname) %></h1>
    <p class="text-sm text-gray-600 dark:text-gray-300"><%= t(".intro", petname: petname) %></p>
  </div>

  <div class="flex flex-col md:flex-row justify-center items-center gap-3 mb-6">
    <% if @check %>
      <span class="text-sm text-gray-700 dark:text-gray-200"><%= t(".checked_on", date: l(@check.checked_on, format: :long)) %></span>
    <% end %>
    <% if @checked_today %>
      <span class="text-sm italic text-gray-500 dark:text-gray-400"><%= t(".refresh_tomorrow") %></span>
    <% else %>
      <%= button_to t(".refresh"), pet_kibble_prices_path(@pet), class: "rounded-md px-3.5 py-2 text-sky-700 bg-sky-200 border-2 border-sky-200 font-medium transition duration-300 hover:bg-gray-100 hover:border-sky-600 cursor-pointer" %>
    <% end %>
    <%= link_to t(".favorite_list", petname: petname), favorite_food_pet_trackers_path(@pet), class: "rounded-md px-3.5 py-2 text-rose-600 bg-rose-100 border-2 border-rose-100 font-medium transition duration-300 hover:bg-gray-100 hover:border-rose-600" %>
  </div>

  <% if @check.nil? %>
    <div class="p-8 border-2 border-orange-200 bg-orange-100 rounded-lg shadow-lg text-center text-gray-700">
      <%= t(".no_check_yet", petname: petname) %>
    </div>
  <% elsif @check.pending? %>
    <div class="p-8 border-2 border-sky-200 bg-sky-50 rounded-lg shadow-lg text-center text-gray-700">
      <%= t(".pending") %>
    </div>
  <% elsif @check.failed? %>
    <div class="p-8 border-2 border-red-200 bg-red-50 rounded-lg shadow-lg text-center text-gray-700">
      <%= t(".failed") %>
    </div>
  <% elsif @check.kibbles.empty? %>
    <div class="p-8 border-2 border-orange-200 bg-orange-100 rounded-lg shadow-lg text-center text-gray-700">
      <%= t(".no_favorites", petname: petname, months: Pet::FAVORITE_KIBBLE_WINDOW.in_months.to_i) %>
    </div>
  <% else %>
    <% @check.kibbles.each do |kibble| %>
      <% prices = @check.prices_for(kibble["brand"], kibble["description"]) %>
      <section class="mb-6 border-2 border-slate-200 rounded-xl shadow-lg overflow-hidden">
        <div class="flex flex-wrap justify-between items-baseline gap-2 px-4 py-3 bg-gray-100 dark:bg-slate-800">
          <h2 class="font-semibold text-lg capitalize"><%= kibble["brand"] %> · <%= kibble["description"] %></h2>
          <span class="text-sm text-gray-600 dark:text-gray-300"><%= t(".favorite_score", score: kibble["favorite_score"]) %></span>
        </div>

        <% if prices.empty? %>
          <p class="px-4 py-4 text-gray-700 dark:text-gray-200"><%= t(".no_listings") %></p>
        <% else %>
          <%# Phones: one card per price, as a seven-column table is too narrow there. %>
          <ol class="md:hidden divide-y-2 divide-slate-200 dark:bg-slate-100 dark:text-gray-800">
            <% prices.each_with_index do |price, index| %>
              <li class="px-4 py-3 text-sm <%= "bg-emerald-50" if index.zero? %>">
                <div class="flex justify-between items-baseline gap-2">
                  <span class="font-semibold"><%= index + 1 %>. <%= kibble_twd(price.price_per_kg, precision: 1) %> / kg</span>
                  <span class="rounded-full px-2 py-0.5 text-xs bg-emerald-100 text-emerald-700 whitespace-nowrap">✔ <%= t(".listed", source: price.source_before_type_cast) %></span>
                </div>
                <div class="mt-1"><%= kibble_product_link(price, class: "text-sky-700 hover:underline") %></div>
                <% if price.variant.present? %><div class="text-xs text-gray-500"><%= price.variant %></div><% end %>
                <div class="mt-1 text-gray-600"><%= price.store %> · <%= kibble_twd(price.price_twd) %> · <%= kibble_bag_size(price) %></div>
              </li>
            <% end %>
          </ol>
          <div class="hidden md:block overflow-x-auto">
            <table class="table-auto w-full text-sm dark:bg-slate-100 dark:text-gray-800">
              <thead>
                <tr class="border-b-4 bg-gray-50">
                  <th class="p-2 text-center">#</th>
                  <th class="p-2 text-left"><%= t(".store") %></th>
                  <th class="p-2 text-left"><%= t(".product") %></th>
                  <th class="p-2 text-right"><%= t(".price") %></th>
                  <th class="p-2 text-right"><%= t(".bag_size") %></th>
                  <th class="p-2 text-right"><%= t(".per_kg") %></th>
                  <th class="p-2 text-center"><%= t(".source") %></th>
                </tr>
              </thead>
              <tbody>
                <% prices.each_with_index do |price, index| %>
                  <tr class="border-b-2 <%= "bg-emerald-50" if index.zero? %>">
                    <td class="p-2 text-center font-semibold"><%= index + 1 %></td>
                    <td class="p-2"><%= price.store %></td>
                    <td class="p-2">
                      <%= kibble_product_link(price, class: "text-sky-700 hover:underline") %>
                      <% if price.variant.present? %><div class="text-xs text-gray-500"><%= price.variant %></div><% end %>
                    </td>
                    <td class="p-2 text-right whitespace-nowrap"><%= kibble_twd(price.price_twd) %></td>
                    <td class="p-2 text-right whitespace-nowrap"><%= kibble_bag_size(price) %></td>
                    <td class="p-2 text-right whitespace-nowrap font-semibold"><%= kibble_twd(price.price_per_kg, precision: 1) %></td>
                    <td class="p-2 text-center whitespace-nowrap">
                      <span class="inline-block rounded-full px-2 py-0.5 text-xs bg-emerald-100 text-emerald-700" title="<%= t(".listed_note", source: price.source_before_type_cast, date: l(@check.checked_on)) %>">✔ <%= t(".listed", source: price.source_before_type_cast) %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="px-4 py-2 text-xs text-gray-500 dark:text-gray-400">
            <%= t(".listed_note", source: prices.map(&:source_before_type_cast).uniq.to_sentence, date: l(@check.checked_on)) %>
          </p>
        <% end %>

      </section>
    <% end %>
  <% end %>

  <p class="text-xs text-center text-gray-500 dark:text-gray-400"><%= t(".disclaimer") %></p>
</div>
