<div style="font-family: Arial, 'PingFang TC', 'Microsoft JhengHei', sans-serif; color: #1f2937; max-width: 600px;">
  <p><%= t(".intro", owner: @owner_name, pets: @pet_names.presence || t(".their_cats")) %></p>
  <p><%= t(".what_you_can_do") %></p>
  <p style="margin: 24px 0;">
    <%= link_to t(".join", owner: @owner_name), @join_url,
          style: "background: #0369a1; color: #ffffff; padding: 10px 16px; border-radius: 6px; text-decoration: none;" %>
  </p>
  <p style="font-size: 12px; color: #6b7280;"><%= t(".fine_print", email: @invitation.email, date: l(@invitation.expires_at.to_date, format: :long)) %></p>
</div>
