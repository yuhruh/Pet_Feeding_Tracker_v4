<!DOCTYPE html>
<html  lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Aji Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag 'aji_favicon_32.png' %>

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    
    <script type="module" nonce="<%= content_security_policy_nonce %>">
      import Big from "big.js";
      window.BigNumber = Big;
    </script>

  </head>

  <body class="dark:bg-darkBlue dark:text-white">
    <%# Android app notifications (checkpoint I): keeps this phone's token registered while signed in.
        registered: whether this sign-in has a phone, so a new sign-in in the same app run registers again. %>
    <% if authenticated? %>
      <div data-controller="push" data-push-url-value="<%= device_token_path %>"
           data-push-registered-value="<%= Current.session.device_tokens.exists? %>" hidden></div>
    <% end %>
    <%= render 'layouts/navigation' unless content_for?(:without_app_menu) %>
    <%= render 'layouts/messages' %>
    
    <%= yield %>
  </body>
</html>
