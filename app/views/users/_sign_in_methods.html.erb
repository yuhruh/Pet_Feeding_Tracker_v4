<%# Every way into this account. Google, LINE and GitHub can be disconnected, or connected (on the website: providers refuse the app's WebView). %>
<% connected = Current.user.connected_services.pluck(:provider) %>
<div id="sign-in-methods" class="flex flex-col items-center text-center gap-2 py-4">
  <h2 class="text-lg font-semibold md:text-xl"><%= t(".title") %></h2>
  <p class="text-sm italic text-gray-500 dark:text-gray-300"><%= t(".description") %></p>

  <div class="w-full max-w-sm text-left divide-y divide-slate-300 dark:divide-slate-600">
    <div class="flex items-center gap-3 py-2">
      <span class="w-6 shrink-0 text-center text-xl" aria-hidden="true">🔑</span>
      <div class="flex-1 min-w-0">
        <div class="font-semibold"><%= t(".password") %></div>
        <div class="text-sm text-gray-500 dark:text-gray-300 break-all"><%= Current.user.email_address %></div>
      </div>
      <%= link_to t(".change"), edit_users_path, class: "text-sm text-grayishBlue underline" %>
    </div>

    <% ConnectedService::PROVIDERS.each do |provider| %>
      <% name = ConnectedService.provider_name(provider) %>
      <div class="flex items-center gap-3 py-2" data-sign-in-method="<%= provider %>">
        <span class="w-6 shrink-0 flex justify-center" aria-hidden="true">
          <% if provider == "google_oauth2" %>
            <%= image_tag "icons8-google-40.png", alt: "", class: "w-6 h-6" %>
          <% elsif provider == "line" %>
            <%= image_tag "icons8-line-48.png", alt: "", class: "w-6 h-6" %>
          <% else %>
            <%= svg "github" %>
          <% end %>
        </span>
        <div class="flex-1 min-w-0">
          <div class="font-semibold"><%= name %></div>
          <% if connected.include?(provider) %>
            <div class="text-sm text-green-600 dark:text-green-400"><%= t(".connected") %></div>
          <% else %>
            <div class="text-sm text-gray-500 dark:text-gray-300"><%= t(".not_connected") %></div>
          <% end %>
        </div>
        <% if connected.include?(provider) %>
          <%= button_to t(".disconnect"), sign_in_method_path(provider: provider), method: :delete,
                form: { data: { turbo_confirm: t(provider == "line" ? ".disconnect_confirm_line" : ".disconnect_confirm", provider: name) } },
                class: "text-sm text-red-600 underline cursor-pointer" %>
        <% elsif !hotwire_native_app? %>
          <%= button_to t(".connect"), "/auth/#{provider}?from=profile", form: { data: { turbo: false } },
                class: "px-3 py-1 text-sm font-semibold text-sky-700 bg-sky-200 rounded shadow-md border-2 border-sky-200 hover:bg-white" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if hotwire_native_app? && (ConnectedService::PROVIDERS - connected).any? %>
    <p class="text-sm italic text-gray-500 dark:text-gray-300"><%= t(".connect_on_website") %></p>
  <% end %>
</div>
